---
import type { Lang } from '../data/site';
import { getContent } from '../data/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const data = getContent(lang).gallery;
---

<section id="gallery" class="relative scroll-mt-20 border-t border-white/5 bg-ink-900/40 py-20 sm:py-28">
  <div class="bg-dots absolute inset-0 opacity-25"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal">
      <SectionHeading eyebrow={data.eyebrow} title={data.title} description={data.description} />
    </div>

    <div class="mt-14 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        data.items.map((item, i) => (
          <figure
            class:list={['reveal card-surface card-hover group overflow-hidden rounded-2xl']}
            style={`transition-delay:${(i % 4) * 60}ms`}
          >
            <div class="aspect-[4/3] overflow-hidden bg-ink-950">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <figcaption class="p-3 text-center text-xs font-medium text-slate-300">
              {item.title}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
