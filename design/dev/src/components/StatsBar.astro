---
import type { Lang } from '../data/site';
import { getContent } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const stats = getContent(lang).stats;
---

<section class="relative border-y border-white/5 bg-ink-900/60 py-14">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 sm:px-6 lg:grid-cols-4 lg:px-8">
    {
      stats.map((s, i) => (
        <div
          class:list={['reveal text-center']}
          style={`transition-delay:${i * 80}ms`}
        >
          <div class="font-display text-4xl font-bold text-gradient sm:text-5xl">{s.value}</div>
          <div class="mt-2 text-sm text-slate-400">{s.label}</div>
        </div>
      ))
    }
  </div>
</section>
