---
import type { Lang } from '../data/site';
import { getContent, langUrl } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const data = getContent(lang).footer;
const nav = getContent(lang).nav;
const enUrl = langUrl('en');
const chUrl = langUrl('ch');
const socials = [
  { name: 'facebook', url: data.social.facebook, label: 'Facebook' },
  { name: 'twitter', url: data.social.twitter, label: 'X' },
  { name: 'youtube', url: data.social.youtube, label: 'YouTube' },
  { name: 'linkedin', url: data.social.linkedin, label: 'LinkedIn' },
];
---

<footer class="relative border-t border-white/5 bg-ink-900/70">
  <div class="bg-grid absolute inset-0 opacity-20"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- About -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3">
          <img src="/Bridgetek_FA.svg" alt={nav.brand.name} class="h-9 w-auto brightness-0 invert" width="120" height="36" />
          <span class="flex flex-col leading-none">
            <span class="font-display text-lg font-bold text-white">{nav.brand.name}</span>
            <span class="text-xs font-semibold uppercase tracking-[0.3em] text-eve-400">{nav.brand.sub}</span>
          </span>
        </a>
        <h3 class="mt-6 text-sm font-semibold uppercase tracking-wider text-slate-400">{data.aboutTitle}</h3>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-500">{data.aboutText}</p>

        <div class="mt-6 flex items-center gap-3">
          {
            socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition-all hover:border-eve-400/50 hover:text-eve-300 hover:shadow-glow-sm"
              >
                <Icon name={s.name} size={18} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">{data.linksTitle}</h3>
        <ul class="mt-4 space-y-2.5">
          {
            data.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="inline-flex items-center gap-1.5 text-sm text-slate-400 transition-colors hover:text-eve-300"
                >
                  {link.label}
                  <Icon name="external" size={12} class="opacity-0 transition-opacity group-hover:opacity-100" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">{data.contactTitle}</h3>
        <address class="mt-4 space-y-3 not-italic text-sm text-slate-400">
          <div class="flex items-start gap-2.5">
            <Icon name="map-pin" size={16} class="mt-0.5 shrink-0 text-eve-400" />
            <span>{data.address}</span>
          </div>
          <div class="flex items-center gap-2.5">
            <Icon name="phone" size={16} class="shrink-0 text-eve-400" />
            <a href="tel:+6565474827" class="transition-colors hover:text-eve-300">{data.tel}</a>
          </div>
          <div class="flex items-center gap-2.5">
            <Icon name="globe" size={16} class="shrink-0 text-eve-400" />
            <a href="https://www.brtchip.com" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-eve-300">
              {data.website}
            </a>
          </div>
        </address>

        <!-- Language -->
        <div class="mt-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">{nav.language.label}</h3>
          <div class="mt-3 flex items-center gap-1 rounded-full border border-white/10 bg-white/5 p-1 w-fit">
            <a href={enUrl} class="lang-pill rounded-full px-3.5 py-1.5 text-xs font-semibold text-slate-200" aria-current={lang === 'en'}>
              {nav.language.en}
            </a>
            <a href={chUrl} class="lang-pill rounded-full px-3.5 py-1.5 text-xs font-semibold text-slate-200" aria-current={lang === 'ch'}>
              {nav.language.ch}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright bar -->
  <div class="relative border-t border-white/5 bg-ink-950/60 py-6">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 text-center text-xs text-slate-500 sm:flex-row sm:px-6 sm:text-left lg:px-8">
      <span>© {new Date().getFullYear()} {data.copyright}</span>
      <a href="https://www.brtchip.com" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-eve-300">
        {data.website}
      </a>
    </div>
  </div>
</footer>
