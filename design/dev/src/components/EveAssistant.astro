---
import type { Lang } from '../data/site';
import { getContent } from '../data/site';
import Icon from './Icon.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const content = getContent(lang).assistant;
---

<section id="eve-assistant" aria-labelledby="assistant-title" class="relative border-y border-eve-500/15 bg-ink-900/60 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-eve-500/30 bg-eve-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-eve-300">
          <Icon name="sparkles" size={16} />{content.eyebrow}
        </span>
        <h2 id="assistant-title" class="mt-5 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{content.title}</h2>
        <p class="mt-4 text-xl font-medium text-eve-200">{content.headline}</p>
        <p class="mt-4 text-base leading-relaxed text-slate-300">{content.description}</p>
        <p class="mt-5 text-xs font-medium leading-relaxed text-slate-400">{content.families}</p>
        <a href={content.cta.url} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-eve-500 to-azure-500 px-6 py-3.5 text-sm font-semibold text-ink-950 transition hover:brightness-110">
          {content.cta.label}<Icon name="external" size={17} />
        </a>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-slate-400">{content.install}</p>
      </div>
      <div class="card-surface rounded-3xl p-6 sm:p-8">
        <h3 class="font-display text-lg font-semibold text-white">{content.promptsTitle}</h3>
        <ul class="mt-5 space-y-3">
          {content.prompts.map((prompt) => (
            <li class="rounded-2xl border border-white/10 bg-ink-950/60 px-5 py-4 text-sm leading-relaxed text-slate-200">{prompt}</li>
          ))}
        </ul>
        <p class="mt-5 text-xs leading-relaxed text-slate-400">{content.note}</p>
      </div>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {content.features.map((feature) => (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <Icon name={feature.icon} size={24} class="text-eve-400" />
          <h3 class="mt-4 font-display text-lg font-semibold text-white">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{feature.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
